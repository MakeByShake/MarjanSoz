# ИИ «Маржан ұстаз» (lib/ai): бесплатный ключ Gemini — aistudio.google.com → Get API key.
# Локально: скопируйте в .env.local. На Vercel: Settings → Environment Variables.
GEMINI_API_KEY=

# Кэш ответов ИИ и лимиты запросов: Upstash Redis (Vercel → Storage → Upstash for Redis → Connect).
# На Vercel добавляются сами. Без них на сайте ИИ отвечает заготовками из базы, локально — работает без лимитов.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Для полного удаления пользователей из админки (аккаунт входа тоже). Firebase Console → Project settings →
# Service accounts → Generate new private key → весь JSON одной строкой. Без него удаляются только данные.
FIREBASE_SERVICE_ACCOUNT=
